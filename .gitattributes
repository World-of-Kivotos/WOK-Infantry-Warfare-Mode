# Disable autocrlf on generated files, they always generate with LF
# Add any extra files or paths here to make git stop saying they
# are changed when only line endings change.
src/generated/**/.cache/cache text eol=lf
src/generated/**/*.json text eol=lf

# Model assets are hash-checked by tests (LargeSupplyStationModelContractTest) and must stay byte-exact
# on Windows checkouts with core.autocrlf=true.
*.geo.json -text
# The tablet animation's comparison vectors are written by ui-preview's export-java-vectors.mjs;
# its --check compares them byte for byte.
wok_infantry/src/test/resources/tablet_anim/vectors.json -text
*.obj -text
*.mtl -text
# The tablet animation's sounds (0.5.0-beta.4) are binary Ogg Vorbis.
*.ogg binary
